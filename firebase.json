{
  "hosting": {
    "public": "./",
    "ignore": [
      "**/.*",
      "app/**/*.js",
      "firebase.json",
      "gulpfile.js",
      "**/node_modules/**",
      "package.json",
      "README.md",
      "firebase-rules.json"
    ],
    "rules": "firebase-rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}